	Highlight.Name = "WhiteNeonESP"
	Highlight.Adornee = Character
	Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	Highlight.FillColor = WHITE
	Highlight.OutlineColor = WHITE
	Highlight.FillTransparency = 0.92
	Highlight.OutlineTransparency = 0
	Highlight.Enabled = Enabled
	Highlight.Parent = Character

	table.insert(Effects[Player],Highlight)

	local Billboard = Instance.new("BillboardGui")

	Billboard.Name = "WhiteNeonInfo"
	Billboard.Adornee = Root
	Billboard.Size = UDim2.fromOffset(250,70)
	Billboard.StudsOffset = Vector3.new(0,4.2,0)
	Billboard.AlwaysOnTop = true
	Billboard.MaxDistance = math.huge
	Billboard.LightInfluence = 0
	Billboard.ResetOnSpawn = false
	Billboard.Enabled = Enabled
	Billboard.Parent = Root

	table.insert(Effects[Player],Billboard)

	local Text = Instance.new("TextLabel")

	Text.Name = "Info"
	Text.Size = UDim2.fromScale(1,1)
	Text.BackgroundTransparency = 1
	Text.TextColor3 = WHITE
	Text.TextStrokeColor3 = Color3.fromRGB(0,0,0)
	Text.TextStrokeTransparency = 0
	Text.Font = Enum.Font.GothamBold
	Text.TextSize = 12
	Text.TextWrapped = true
	Text.Parent = Billboard

	table.insert(Effects[Player],Text)

	local StarsAttachment = Instance.new("Attachment")

	StarsAttachment.Name = "WhiteStars"
	StarsAttachment.Parent = Root

	table.insert(Effects[Player],StarsAttachment)

	local Stars = MakeParticle(
		StarsAttachment,
		"rbxasset://textures/particles/sparkles_main.dds",
		22,
		NumberRange.new(0.8,1.5),
		NumberRange.new(0.3,1),
		NumberSequence.new({
			NumberSequenceKeypoint.new(0,0.18),
			NumberSequenceKeypoint.new(0.5,0.1),
			NumberSequenceKeypoint.new(1,0)
		})
	)

	Stars.Enabled = Enabled

	table.insert(Effects[Player],Stars)

	local Nebula = MakeParticle(
		StarsAttachment,
		"rbxasset://textures/particles/smoke_main.dds",
		8,
		NumberRange.new(1,2),
		NumberRange.new(0.2,0.7),
		NumberSequence.new({
			NumberSequenceKeypoint.new(0,0.55),
			NumberSequenceKeypoint.new(0.5,0.75),
			NumberSequenceKeypoint.new(1,1)
		})
	)

	Nebula.Enabled = Enabled

	table.insert(Effects[Player],Nebula)

	local Rays = MakeParticle(
		StarsAttachment,
		"rbxasset://textures/particles/rays_main.dds",
		6,
		NumberRange.new(0.7,1.4),
		NumberRange.new(0.2,0.8),
		NumberSequence.new({
			NumberSequenceKeypoint.new(0,0.25),
			NumberSequenceKeypoint.new(0.6,0.45),
			NumberSequenceKeypoint.new(1,1)
		})
	)

	Rays.Enabled = Enabled

	table.insert(Effects[Player],Rays)

	local Light = Instance.new("PointLight")

	Light.Name = "WhiteESPGlow"
	Light.Color = WHITE
	Light.Brightness = 36.67
	Light.Range = 3.67
	Light.Shadows = false
	Light.Enabled = Enabled
	Light.Parent = Root

	table.insert(Effects[Player],Light)

	local Connection

	Connection = RunService.RenderStepped:Connect(function()
		if not Character.Parent or not Root.Parent or not Humanoid.Parent then
			if Connection then
				Connection:Disconnect()
			end

			return
		end

		if not Enabled then
			return
		end

		local HP = math.floor(Humanoid.Health)
		local MaxHP = math.floor(Humanoid.MaxHealth)

		local Distance = 0

		if LP.Character then
			local MyRoot = LP.Character:FindFirstChild("HumanoidRootPart")

			if MyRoot then
				Distance = math.floor((MyRoot.Position - Root.Position).Magnitude)
			end
		end

		Text.Text =
			Player.DisplayName ..
			"\n@" ..
			Player.Name ..
			"\nHP: " ..
			HP ..
			" / " ..
			MaxHP ..
			"    DIST: " ..
			Distance ..
			"m"
	end)

	table.insert(Effects[Player],Connection)
end

local function CreateBeam(Player, Character)
	if Player == LP then
		return
	end

	if not Enabled then
		return
	end

	local Root = Character:FindFirstChild("HumanoidRootPart")

	if not Root or not CoreAttachment then
		return
	end

	local EndAttachment = Instance.new("Attachment")

	EndAttachment.Name = "WhiteBeamEnd"
	EndAttachment.Parent = Root

	local Beam = Instance.new("Beam")

	Beam.Name = "WhiteNeonBeam"
	Beam.Attachment0 = CoreAttachment
	Beam.Attachment1 = EndAttachment
	Beam.FaceCamera = true
	Beam.Color = ColorSequence.new(WHITE)
	Beam.LightEmission = 1
	Beam.LightInfluence = 0
	Beam.Width0 = BEAM_WIDTH
	Beam.Width1 = BEAM_WIDTH
	Beam.Segments = 20
	Beam.Transparency = NumberSequence.new(0)
	Beam.Enabled = Enabled
	Beam.Parent = EffectFolder

	if not Effects[Player] then
		Effects[Player] = {}
	end

	table.insert(Effects[Player],EndAttachment)
	table.insert(Effects[Player],Beam)
end

local function SetupPlayer(Player)
	if Player == LP then
		return
	end

	if CharacterConnections[Player] then
		CharacterConnections[Player]:Disconnect()
		CharacterConnections[Player] = nil
	end

	local function CharacterSetup(Character)
		task.wait(0.5)

		if not Character.Parent then
			return
		end

		if not Enabled then
			CleanupPlayerEffects(Player)
			return
		end

		CreateESP(Player,Character)

		task.wait(0.1)

		if Enabled and CoreAttachment then
			CreateBeam(Player,Character)
		end
	end

	if Player.Character and Enabled then
		task.spawn(function()
			CharacterSetup(Player.Character)
		end)
	end

	CharacterConnections[Player] = Player.CharacterAdded:Connect(function(Character)
		CharacterSetup(Character)
	end)
end

local function CreateAllCurrentESP()
	if not Enabled then
		return
	end

	for _,Player in ipairs(Players:GetPlayers()) do
		if Player ~= LP and Player.Character then
			task.spawn(function()
				CreateESP(Player,Player.Character)

				task.wait(0.1)

				if Enabled and CoreAttachment and Player.Character then
					CreateBeam(Player,Player.Character)
				end
			end)
		end
	end
end

local function SetEverythingEnabled(State)
	Enabled = State

	if not State then
		for _,Player in ipairs(Players:GetPlayers()) do
			if Player ~= LP then
				CleanupPlayerEffects(Player)
			end
		end

		if CorePart then
			CorePart.Transparency = 1

			for _,Object in ipairs(CorePart:GetChildren()) do
				if Object:IsA("ParticleEmitter") or Object:IsA("PointLight") then
					Object.Enabled = false
				end
			end
		end

		return
	end

	if CorePart then
		CorePart.Transparency = 0

		for _,Object in ipairs(CorePart:GetChildren()) do
			if Object:IsA("ParticleEmitter") or Object:IsA("PointLight") then
				Object.Enabled = true
			end
		end
	end

	CreateAllCurrentESP()
end

RunService.RenderStepped:Connect(function()
	local Character = LP.Character
	local Root = Character and Character:FindFirstChild("HumanoidRootPart")

	if not Root then
		return
	end

	if CorePart then
		CorePart.CFrame = Root.CFrame * CFrame.new(0,0,CORE_DISTANCE)
	end
end)

for _,Player in ipairs(Players:GetPlayers()) do
	SetupPlayer(Player)
end

Players.PlayerAdded:Connect(function(Player)
	SetupPlayer(Player)
end)

Players.PlayerRemoving:Connect(function(Player)
	CleanupPlayerEffects(Player)

	if CharacterConnections[Player] then
		CharacterConnections[Player]:Disconnect()
		CharacterConnections[Player] = nil
	end
end)

if LP.Character then
	task.spawn(function()
		task.wait(0.5)
		CreateCore(LP.Character)
	end)
end

LP.CharacterAdded:Connect(function(Character)
