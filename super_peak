local function MakeParticle(Parent, Texture, Rate, Lifetime, Speed, Size)
	local P = Instance.new("ParticleEmitter")

	P.Texture = Texture
	P.Rate = Rate
	P.Lifetime = Lifetime
	P.Speed = Speed
	P.Size = Size
	P.Color = ColorSequence.new(WHITE)
	P.LightEmission = 1
	P.LightInfluence = 0

	P.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0,0),
		NumberSequenceKeypoint.new(0.7,0.15),
		NumberSequenceKeypoint.new(1,1)
	})

	P.Parent = Parent

	return P
end

local function CreateCore(Character)
	local Root = Character:FindFirstChild("HumanoidRootPart")

	if not Root then
		return
	end

	if CorePart then
		CorePart:Destroy()
		CorePart = nil
		CoreAttachment = nil
	end

	local Core = Instance.new("Part")

	Core.Name = "WhiteNeonCore"
	Core.Shape = Enum.PartType.Ball
	Core.Size = Vector3.new(CORE_SIZE,CORE_SIZE,CORE_SIZE)
	Core.Material = Enum.Material.Neon
	Core.Color = WHITE
	Core.Anchored = true
	Core.CanCollide = false
	Core.CanTouch = false
	Core.CanQuery = true
	Core.CastShadow = true

	Core.Parent = EffectFolder

	CorePart = Core

	local Attachment = Instance.new("Attachment")

	Attachment.Name = "WhiteCoreAttachment"
	Attachment.Parent = Core

	CoreAttachment = Attachment

	local Light = Instance.new("PointLight")

	Light.Color = WHITE
	Light.Brightness = 5
	Light.Range = 18
	Light.Shadows = true
	Light.Enabled = Enabled

	Light.Parent = Core

	MakeParticle(
		Core,
		"rbxasset://textures/particles/sparkles_main.dds",
		35,
		NumberRange.new(0.7,1.3),
		NumberRange.new(0.5,1.5),
		NumberSequence.new({
			NumberSequenceKeypoint.new(0,0.25),
			NumberSequenceKeypoint.new(0.5,0.12),
			NumberSequenceKeypoint.new(1,0)
		})
	)
end

local function SetCharacterTransparency(Value)
	CharacterTransparency = math.clamp(Value,0,1)

	local Character = LP.Character

	if not Character then
		return
	end

	for _,Object in ipairs(Character:GetDescendants()) do
		if Object:IsA("BasePart") then
			if Object.Name ~= "HumanoidRootPart" then
				Object.LocalTransparencyModifier = CharacterTransparency
			end
		elseif Object:IsA("Decal") or Object:IsA("Texture") then
			Object.Transparency = CharacterTransparency
		end
	end
end

local function CleanupPlayerEffects(Player)
	if Effects[Player] then
		for _,Object in ipairs(Effects[Player]) do
			pcall(function()
				if typeof(Object) == "RBXScriptConnection" then
					Object:Disconnect()
				elseif Object and Object.Destroy then
					Object:Destroy()
				end
			end)
		end

		Effects[Player] = nil
	end
end

local function CreateESP(Player, Character)
	if Player == LP then
